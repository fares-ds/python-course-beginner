# Copy this file to `.env` (no extension prefix) and edit the values if needed.
# The defaults below work if you ran `ollama serve` on the same machine.

# Which model Ollama should use. Pull it first with: ollama pull qwen2.5-coder:7b
OLLAMA_MODEL=qwen2.5-coder:7b

# Where Ollama is listening. The default is fine unless you changed it.
OLLAMA_BASE_URL=http://localhost:11434
